msgid "`SOLID <https://en.wikipedia.org/wiki/SOLID>`__"
msgstr "`SOLID <https://en.wikipedia.org/wiki/SOLID>`_"

#, fuzzy
msgid "`DRY <https://en.wikipedia.org/wiki/Don%27t_repeat_yourself>`__"
msgstr "`DRY <https://en.wikipedia.org/wiki/Don%27t_repeat_yourself>`_"

