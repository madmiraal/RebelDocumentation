msgstr "Luces direccionales (sol / luna). Hasta 4 por escena."

msgid "Omnidirectional lights."
msgstr "Luces omnidireccionales."

msgid "Spot lights with adjustable cone angle and attenuation."
msgstr "Focos con ángulo de cono ajustable y atenuación."

