msgid "hint_color"
msgstr "hint_color"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:572
msgid "Used as color."
msgstr "Utilizado como color."

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:574
msgid "**int, float**"
msgstr "**int, float**"

#: ../../docs/tutorials/shaders/shader_reference/shading_language.rst:574
msgid "hint_range(min, max[, step])"
