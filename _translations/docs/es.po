msgid "``TYPE_*``"
msgstr "``TYPE_*``"

#: ../../docs/tutorials/scripting/c_sharp/c_sharp_differences.rst:33
msgid "``Variant.Type`` enum"
msgstr "``Variant.Type`` (enumeración)"

#: ../../docs/tutorials/scripting/c_sharp/c_sharp_differences.rst:34
msgid "``OP_*``"
msgstr "``OP_*``"

#: ../../docs/tutorials/scripting/c_sharp/c_sharp_differences.rst:34
